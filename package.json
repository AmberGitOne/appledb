{
  "name": "apple-globalcare-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Apple Globalcare CRM - full stack (Express + SQLite) pharmaceutical sourcing and patient services CRM",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "reset": "node server/db/migrate.js --fresh && node server/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "test": "node scripts/smoke-test.js",
    "start:prod": "node server/db/bootstrap.js && node server/index.js",
    "bootstrap": "node server/db/bootstrap.js",
    "db:local": "node scripts/dev-postgres.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
